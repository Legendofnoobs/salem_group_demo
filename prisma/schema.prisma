datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id            String           @id @default(uuid())
  title         String
  slug          String           @unique
  category      String           // "mac", "iphone", "ipad", "watch", "airpods", "accessories"
  basePrice     Float
  salePrice     Float?
  condition     String           // "NEW_SEALED", "OPEN_BOX", "CERTIFIED_PRE_OWNED"
  batteryHealth Int?             // e.g. 100 for open box, 89 for pre-owned
  description   String
  specs         Json             // chip, unifiedMemory, storage, display, ports
  warrantyInfo  String           // e.g. "Salem 1-Year Warranty + Official Apple Coverage"
  images        String[]         // Base64 strings: data:image/png;base64,...
  isFeatured    Boolean          @default(false)
  stock         Int              @default(1)
  variants      ProductVariant[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([category])
  @@index([condition])
}

model ProductVariant {
  id            String   @id @default(uuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorName     String
  colorHex      String
  storageOption String
  ramOption     String?
  priceDelta    Float    @default(0)
  serialNumber  String?
  stock         Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([productId])
}

model Order {
  id              String   @id @default(uuid())
  orderNumber     String   @unique
  customerName    String
  customerPhone   String
  customerEmail   String?
  shippingAddress String
  city            String
  paymentMethod   String   @default("CASH_ON_DELIVERY")
  status          String   @default("PENDING") // PENDING, CONFIRMED, PROCESSING, SHIPPED, DELIVERED, CANCELLED
  items           Json
  subtotal        Float
  shippingCost    Float    @default(0)
  totalAmount     Float
  trafficSource   String?  @default("Direct")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([orderNumber])
}

model TradeIn {
  id                  String   @id @default(uuid())
  customerName        String
  customerPhone       String
  deviceCategory      String
  deviceModel         String
  batteryHealth       Int
  physicalCondition   String
  accessoriesIncluded Json
  estimatedTradeValue Float
  desiredUpgrade      String?
  status              String   @default("NEW_LEAD") // NEW_LEAD, CONTACTED, INSPECTING, ACCEPTED, DECLINED
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status])
}

model AnalyticsEvent {
  id            String   @id @default(uuid())
  eventType     String   // SEARCH, PRODUCT_VIEW, ADD_TO_CART, CHECKOUT_INITIATED, CHECKOUT_COMPLETED, CHECKOUT_ABANDONED
  productId     String?
  productTitle  String?
  searchQuery   String?
  hasResults    Boolean?
  trafficSource String?  @default("Direct")
  sessionId     String
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([eventType])
  @@index([hasResults])
  @@index([trafficSource])
  @@index([createdAt])
}

model StoreSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}
